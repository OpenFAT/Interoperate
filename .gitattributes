# Byte-exact fixtures, goldens and canonical files: never convert line endings (Windows CI).
* text=auto eol=lf
*.png binary
*.wasm binary
*.raw binary
*.glut binary
*.svg text eol=lf
# Semantic merges of design files; configure per clone with `schemify git-setup`.
*.shprim merge=schemify
*.shcomp merge=schemify
*.shbench merge=schemify
# Fuzz corpora are exact bytes (CRLF, NUL, invalid UTF-8 are the point): never normalize.
fuzz/corpus/** binary
