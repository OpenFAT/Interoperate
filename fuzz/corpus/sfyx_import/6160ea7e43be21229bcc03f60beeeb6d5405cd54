; PDK devices with CDF and simInfo (spec interop.md §6.3), as SfyExportLib writes them.
; A made-up kit: every name, parameter and default is invented for this test.
("sfyx" 1 "SfyExportLib test")
("lib" "demopdk")
("cell" "nmos_demo" "ref")
("cdf" "-model w nf")
("param" "model" "string" "demo_nch" "Device model" "" ("storeDefault") () "")
("param" "w" "string" "300n" "Gate width" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "demoWidthCB()")
("param" "l" "string" "60n" "Gate length" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "nf" "int" "2" "Finger count" "" () () "")
("param" "m" "string" "1" "Parallel devices" "" ("parseAsNumber" "parseAsCEL") () "")
("param" "style" "radio" "a" "Layout style" "" () ("a" "b" "c") "")
("param" "as" "string" "iPar(\"w\")*70n" "Source area" "" ("parseAsNumber" "parseAsCEL") () "")
("param" "guard" "button" "" "Guard ring" "" () () "")
("param" "bulk" "netSet" "vss!" "Bulk net" "" ("storeDefault") () "")
("siminfo" "spectre" (("otherParameters" ("model")) ("instParameters" ("w" "l" "nf" "m" "as")) ("termOrder" ("D" "G" "S" "B")) ("termMapping" (("D" ":d") ("G" ":g") ("S" ":s") ("B" ":b")))))
("siminfo" "auCdl" (("netlistProcedure" "ansCdlCompPrim") ("componentName" "nmos") ("termOrder" ("D" "G" "S" "B")) ("instParameters" ("m" "L" "W")) ("propMapping" (("L" "l") ("W" "w"))) ("namePrefix" "M") ("modelName" "demo_nch")))
("cv" "symbol" "schematicSymbol" 160)
("term" "B" "inputOutput" "")
("term" "D" "inputOutput" "")
("term" "G" "input" "")
("term" "S" "inputOutput" "")
("pinfig" 1 "B" 28 -2 32 2)
("pinfig" 2 "D" 8 38 12 42)
("pinfig" 3 "G" -32 -2 -28 2)
("pinfig" 4 "S" 8 -42 12 -38)
("label" 5 0 "cdsName()" 16 10 "R0" "lowerLeft" "stick" 6 "IL" "annotate" "drawing7")
("label" 6 0 "cdsParam(1)" 16 -4 "R0" "lowerLeft" "stick" 6 "IL" "annotate" "drawing")
("shape" 7 "line" "device" "drawing" (-30 0 -6 0) 0)
("shape" 8 "line" "device" "drawing" (0 20 10 20 10 40) 0)
("shape" 9 "line" "device" "drawing" (0 -20 10 -20 10 -40) 0)
("cell" "res_demo" "ref")
("cdf" "r")
("param" "r" "string" "2k" "Resistance" "resistance" ("parseAsNumber" "parseAsCEL") () "")
("param" "w" "string" "2u" "Width" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "l" "string" "8u" "Length" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "variant" "string" "" "Variant" "" () () "")
("siminfo" "spectre" (("componentName" "resistor") ("instParameters" ("r" "w" "l" "variant")) ("termOrder" ("PLUS" "MINUS"))))
("siminfo" "auCdl" (("netlistProcedure" "ansCdlCompPrim") ("termOrder" ("PLUS" "MINUS")) ("instParameters" ("W" "L")) ("propMapping" (("W" "w") ("L" "l"))) ("namePrefix" "R") ("modelName" "RDEMO")))
("cv" "symbol" "schematicSymbol" 160)
("term" "MINUS" "inputOutput" "")
("term" "PLUS" "inputOutput" "")
("pinfig" 1 "MINUS" -2 -42 2 -38)
("pinfig" 2 "PLUS" -2 38 2 42)
("shape" 3 "rect" "device" "drawing" (-8 -24 8 24) 0)
("end")
