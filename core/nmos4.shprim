schemify 1 shprim
  doc "N-channel MOSFET, 4 terminals: SPICE M element (spiceprefix X calls a subckt model instead)"
  prefix M
  category semiconductor

pin d inout 20 -30
pin g in -20 0
pin s inout 20 30
pin b in 20 0

param spiceprefix ""
  kind string
  doc "instance-name prefix; X when the model is a subcircuit"
param model nmos
  kind string
  doc "SPICE .model or subcircuit name"
param w 1u
  unit m
  doc "channel width"
param l 0.18u
  unit m
  doc "channel length"
param extra ""
  kind string
  doc "further instance parameters, emitted verbatim"
param m 1
  doc "parallel multiplier"

impl spice spice
  format spice "{spiceprefix}{name} {d} {g} {s} {b} {model} w={w} l={l} {extra} m={m}"
  format spectre "{name} ({d} {g} {s} {b}) {model} w={w} l={l} {extra} m={m}"

line -20 0 -10 0
line -10 -10 -10 10
  width 2
line -7.5 -10 -7.5 10
  width 2
line -7.5 -10 20 -10
  width 2
line -7.5 10 20 10
  width 2
line 20 -30 20 -10
line 20 10 20 30
line -7.5 0 20 0

poly 17.5 10 12.5 11.875 12.5 8.125
  fill true
  closed true

stext 25 -28 R0 {name}
  size 0.14
stext 25 -19 R0 {model}
  size 0.14
stext 25 4 R0 {eng(w)}/{eng(l)}
  size 0.14
