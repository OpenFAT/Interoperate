schemify 1 shprim
  doc "Ammeter: a 0 V SPICE V element; its branch current i(<name>) is the current from p to n"
  prefix V
  category probe

pin p inout 0 -30
pin n inout 0 30

param savecurrent true
  kind bool
  doc "also emit .save i(<name>)"

impl spice spice
  format spice "{name} {p} {n} 0{savecurrent ? \"\\n.save i(\" + name + \")\" : \"\"}"
  format spectre "{name} ({p} {n}) vsource dc=0"

line 0 -30 0 -7.5
line 0 7.5 0 30

circle 0 0 7.5
  width 2

stext 0 -4.5 R0 A
  size 0.12
  hcenter
stext 12.5 -9 R0 {name}
  size 0.14
