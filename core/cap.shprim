schemify 1 shprim
  doc "Capacitor: SPICE C element"
  prefix C
  category passive

pin p inout 0 -30
pin n inout 0 30

param value 1p
  kind string
  unit F
  doc "capacitance: SPICE value text (a number, an expression, or a value plus device parameters)"
param m 1
  doc "parallel multiplier"

impl spice spice
  format spice "{name} {p} {n} {value} m={m}"
  format spectre "{name} ({p} {n}) capacitor c={num(value)} m={m}"

line 0 -30 0 -2.5
line 0 2.5 0 30
line -7.5 -2.5 7.5 -2.5
  width 3
line -7.5 2.5 7.5 2.5
  width 3

stext 12.5 -9 R0 {name}
  size 0.14
stext 12.5 0 R0 {value}
  size 0.14
