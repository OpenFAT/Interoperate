schemify 1 shprim
  doc "Lossless transmission line: SPICE T element, port 1 (p1, n1) to port 2 (p2, n2)"
  prefix T
  category passive

pin p1 inout -80 -10
pin n1 inout -80 10
pin p2 inout 80 -10
pin n2 inout 80 10

param z0 50
  unit Ohm
  doc "characteristic impedance"
param td 10n
  unit s
  doc "transmission delay"

impl spice spice
  format spice "{name} {p1} {n1} {p2} {n2} z0={z0} td={td}"
  format spectre "{name} ({p1} {n1} {p2} {n2}) tline z0={z0} td={td}"

line -80 -10 -66.18 -10
line 66.18 -10 80 -10
line -80 10 -66.18 10
line 66.18 10 80 10
line -55 -15 55 -15
  width 2
line -55 15 55 15
  width 2

circle -55 0 15
  width 2

arc 55 0 15 270 180
  width 2

stext -55 -28 R0 {name}
  size 0.14
stext -55 19 R0 "z0={eng(z0)} td={eng(td)}"
  size 0.14
