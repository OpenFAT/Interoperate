schemify 1 shprim
  doc "Independent current source: SPICE I element; current flows from p through the source to m"
  prefix I
  category source

pin p inout 0 -30
pin n inout 0 30

param value 0
  kind string
  doc "SPICE source specification"

impl spice spice
  format spice "{name} {p} {n} {value}"
  format spectre "{name} ({p} {n}) isource {spectre_source(value)}"

line 0 -30 0 -7.5
line 0 7.5 0 30

circle 0 0 7.5
  width 2

line 0 -5 0 0

poly 0 5 -1.875 0 1.875 0
  fill true
  closed true

stext 12.5 -9 R0 {name}
  size 0.14
stext 12.5 0 R0 {value}
  size 0.14
