schemify 1 shprim
  doc "NPN bipolar transistor: SPICE Q element"
  prefix Q
  category semiconductor

pin c inout 20 -30
pin b in -20 0
pin e inout 20 30

param spiceprefix ""
  kind string
  doc "instance-name prefix; X when the model is a subcircuit"
param model npn
  kind string
  doc "SPICE .model name"
param area 1
  doc "area factor"
param m 1
  doc "parallel multiplier"

impl spice spice
  format spice "{spiceprefix}{name} {c} {b} {e} {model} area={area} m={m}"
  format spectre "{name} ({c} {b} {e}) {model} area={area} m={m}"

line -20 0 0 0
line 0 -10 0 10
  width 2
line 0 -5 20 -15
  width 2
line 0 5 20 15
  width 2
line 20 -30 20 -15
line 20 15 20 30

poly 20 15 14.689 14.441 16.366 11.087
  fill true
  closed true

stext 25 -28 R0 {name}
  size 0.14
stext 25 -19 R0 {model}
  size 0.14
