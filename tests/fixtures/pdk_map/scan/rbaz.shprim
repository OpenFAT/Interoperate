schemify 1 shprim
  provenance "pdk-scan fkit/rbaz"

pin p inout 40 0
pin n inout 40 20

param r ""
  kind string
param m ""
  kind string

impl spice spice
  format spice "X{name} {p} {n} rbaz{r != \"\" ? \" r=\" + r : \"\"}{m != \"\" ? \" m=\" + m : \"\"}"
  format spectre "{name} ({p} {n}) rbaz{r != \"\" ? \" r=\" + r : \"\"}{m != \"\" ? \" m=\" + m : \"\"}"

rect -20 -10 20 30

line 20 0 40 0
line 20 20 40 20

stext -20 -20 R0 {name}
