schemify 1 shbench

var CL 1p
var VDD 0.9
var W 1

corner ss_125
  lib ${PDK}/models/toplevel.scs top_ss
  set VDD 0.81
  temp 125

sweep W
  var W
  lin 1 3 3

output bw "ymax(v(OUT)) * 2"
output vmax ymax(v(OUT))

spec vmax
  min 400m
  max 0.9

code TRAN spice
  | .lib ${PDK}/models/toplevel.scs top_tt
  | .ac dec 20 1 10g
  | .op
  | .tran 6e-11 60n

--- report
