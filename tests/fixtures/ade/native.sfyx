("sfyx" 1 "schemify.il 1")
("lib" "schemify")
("cell" "tb" "design")
("cv" "schematic" "schematic" 160)
("maestro" "AC" "schemify" "tb" "schematic" "spectre")
("var" "R1" "1k" "")
("var" "R2" "R1*2" "")
("var" "X" "foo*2" "")
("analysis" "noise" 0 (("start" "1")))
("analysis" "pss" 1 (("fund" "1G") ("harms" "10") ("errpreset" "conservative")))
("analysis" "tran" 1 (("stop" "60n") ("errpreset" "moderate")))
("model" "" "/pdk/models/toplevel.scs" "")
("corner" "fast" 0)
("model" "fast" "/pdk/models/toplevel.scs" "ff")
("var" "VDD" "0.8,0.9" "fast")
("var" "temperature" "-40" "fast")
("output" "BW" "point" "bandwidth(mag(VF(\"/OUT\")) 3 \"low\")")
("output" "OutPlot" "net" "/OUT")
("output" "gm" "point" "deriv(IT(\"/M1/D\"))")
("output" "vavg" "point" "average(VT(\"/OUT\"))")
("spec" "BW" "gt" "1G")
("spec" "vavg" "lt" "0.5")
("defn" "stimuli.scs" "// stimuli\nV1 (in 0) vsource dc=0.45\n")
("maestro" "TRAN2" "schemify" "tb" "schematic" "spectre")
("analysis" "tran" 1 (("stop" "1u")))
("end")
