("sfyx" 1 "schemify.il 1")
("lib" "schemify")
("cell" "tb" "design")
("cv" "schematic" "schematic" 160)
("maestro" "TRAN" "schemify" "tb" "schematic" "spectre")
("var" "CL" "1p" "")
("var" "VDD" "0.9" "")
("var" "W" "1,2,3" "")
("var" "temperature" "27" "")
("analysis" "ac" 1 (("start" "1") ("stop" "10G") ("incrType" "Logarithmic") ("stepTypeLog" "Points Per Decade") ("dec" "20")))
("analysis" "dc" 1 (("saveOppoint" "t")))
("analysis" "tran" 1 (("stop" "60n")))
("model" "" "$PDK/models/toplevel.scs" "top_tt")
("corner" "ss_125" 1)
("model" "ss_125" "$PDK/models/toplevel.scs" "\"top_ss\"")
("var" "VDD" "0.81" "ss_125")
("var" "temperature" "125" "ss_125")
("output" "bw" "point" "ymax(VF(\"/OUT\")) * 2")
("output" "vmax" "point" "ymax(VT(\"/OUT\"))")
("spec" "vmax" "gt" "400m")
("spec" "vmax" "lt" "0.9")
("end")
