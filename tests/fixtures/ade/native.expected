schemify 1 shbench

var R1 1k
var R2 R1*2
var X foo*2

corner fast
  lib /pdk/models/toplevel.scs ff
  temp -40

output vavg avg(v(OUT))

spec vavg
  max 0.5

code AC spectre
  | include /pdk/models/toplevel.scs
  | pss pss fund=1G harms=10 errpreset=conservative
  | tran tran stop=60n errpreset=moderate
  | // ade output BW point: bandwidth(mag(VF("/OUT")) 3 "low")
  | // ade output OutPlot net: /OUT
  | // ade output gm point: deriv(IT("/M1/D"))
code stimuli spectre
  | // stimuli
  | V1 (in 0) vsource dc=0.45

--- report
needs_review:code	tb	analysis noise is disabled in maestro: dropped
needs_review:code	tb	analysis pss has no SPICE form: kept in the spectre block
needs_review:config	tb	corner fast is disabled in maestro
needs_review:config	tb	maestro test TRAN2: only the first test of a view maps
needs_review:design-variable	tb	`foo*2` → `foo*2`
needs_review:expression	tb	corner fast var VDD: a sweep list
needs_review:output	tb	output BW (point) `bandwidth(mag(VF("/OUT")) 3 "low")` has no calculator form
needs_review:output	tb	output OutPlot (net) `/OUT` has no calculator form
needs_review:output	tb	output gm (point) `deriv(IT("/M1/D"))` has no calculator form
needs_review:spec	tb	spec BW gt: its output did not come back
