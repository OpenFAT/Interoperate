schemify 1 shprim
  doc "NMOS transistor (editor fixture)"
  prefix M

pin D inout 20 -30
pin G in -20 0
pin S inout 20 30
pin B in 20 0

param W 1
  unit um
param L 0.15
  unit um
param nf 1
  kind int

impl spice spice
  format spice "M{name} {D} {G} {S} {B} nmos W={W}u L={L}u nf={nf}"

line 20 -30 20 -15
line 20 15 20 30
line 4 -15 20 -15
line 4 15 20 15
line 4 -15 4 15
line 0 -10 0 10
line -20 0 0 0
line 4 0 20 0

poly 12 15 16 12 16 18 12 15
  closed true

stext 25 -27 R0 {name}
  size 0.2
stext 25 12 R0 W={W}
  size 0.15
