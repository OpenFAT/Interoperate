schemify 1 shprim
  doc "sky130 pfet_01v8 (docs-page demo fixture): W and L in metres, emitted in microns"
  prefix M

pin s inout 20 -30
pin g in -20 0
pin d inout 20 30
pin b in 20 0
  inherit VDD

param W 1u
  unit m
param L 0.15u
  unit m
param nf 1
  kind int

impl spice spice
  format spice "X{name} {d} {g} {s} {b} sky130_fd_pr__pfet_01v8 W={W/1u} L={L/1u} nf={nf}"

line 20 -30 20 -15
line 20 15 20 30
line 4 -15 20 -15
line 4 15 20 15
line 4 -15 4 15
line 0 -10 0 10
line -20 0 -7 0
line 4 0 20 0

circle -4 0 3

poly 8 -15 12 -18 12 -12 8 -15
  closed true

stext 25 -30 R0 {name}
  size 0.2
stext 25 1 R0 W={eng(W)}
  size 0.18
stext 25 13 R0 L={eng(L)}
  size 0.18
