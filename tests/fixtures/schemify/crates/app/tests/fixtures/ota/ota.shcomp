schemify 1 shcomp
  doc "Five-transistor OTA sized by gm/Id: the docs page derives every W from the gmid plugin"
  prefix x

pin inp in -60 -20
pin inn in -60 20
pin out out 60 0
pin vbias in 0 40
pin VDD inout 0 -40
pin VSS inout 20 40

impl sch schematic

line -60 -20 -40 -20
line -60 20 -40 20
line 40 0 60 0
line 0 -40 0 -20
line 0 20 0 40
line 20 10 20 40

poly -40 -40 40 0 -40 40 -40 -40
  closed true

stext -34 -27 R0 +
  size 0.2
stext -34 13 R0 -
  size 0.2
stext -40 -56 R0 {name}
  size 0.25

inst m00001 dev:nfet_01v8
  at 60 300 R0
  name M1
  W W_in
  L L_in
inst m00002 dev:nfet_01v8
  at 300 300 R0
  name M2
  W W_in
  L L_in
inst m00003 dev:pfet_01v8
  at 60 200 R0
  name M3
  W W_load
  L L_load
inst m00004 dev:pfet_01v8
  at 300 200 R0
  name M4
  W W_load
  L L_load
inst m00005 dev:nfet_01v8
  at 180 420 R0
  name M5
  W W_tail
  L L_tail

wire w00001 80 140 200 140
wire w00002 200 140 320 140
wire w00003 80 140 80 170
wire w00004 320 140 320 170
wire w00005 200 120 200 140
wire w00006 40 200 40 245
wire w00007 40 245 80 245
wire w00008 80 245 270 245
wire w00009 270 200 270 245
wire w00010 270 200 280 200
wire w00011 80 230 80 245
wire w00012 80 245 80 270
wire w00013 320 230 320 250
wire w00014 320 250 320 270
wire w00015 320 250 400 250
wire w00016 80 330 80 360
wire w00017 320 330 320 360
wire w00018 80 360 200 360
wire w00019 200 360 320 360
wire w00020 200 360 200 390
wire w00021 0 300 40 300
wire w00022 240 300 280 300
wire w00023 120 420 160 420
wire w00024 200 450 200 480

label n00001 200 360 R0 tail

port p00001 0 300 R0 inp
port p00002 240 300 R0 inn
port p00003 400 250 R180 out
port p00004 120 420 R0 vbias
port p00005 200 120 R0 VDD
port p00006 200 480 R0 VSS

text t00001 0 60 R0 "Five-transistor OTA: every W comes from a gm/Id target on the docs page"
  size 0.3

prose d00001
  | # Five-transistor OTA, sized by gm/Id
  |
  | The input pair sets the gain-bandwidth. In strong inversion the square law gives
  | $g_m = \frac{2 I_D}{V_{ov}}$, so $g_m/I_D = 2/V_{ov}$. The **gm/Id method** reads every
  | ratio from simulated lookup tables instead, valid from weak to strong inversion: pick the
  | inversion level $g_m/I_D$ and the length $L$, and the `gmid` plugin returns the current
  | density $J_D = I_D/W$, hence the width
  |
  | $$W = \frac{I_D}{J_D\left(g_m/I_D,\ L\right)}$$
var Id_tail 20u
  unit A
  doc "tail current: sets the power"
var gm_id_in 15
  unit 1/V
  min 5
  max 25
  doc "input pair inversion level (higher is weaker inversion)"
var L_in 0.5u
  unit m
var id_in Id_tail/2
  unit A
var W_in "gmid.w(\"nfet_01v8\", gm_id_in, L_in, id_in)"
  unit m
  cached 3.8813910462992726e-6 6f77c86f9226a930
prose d00002
  | ## Speed and gain
  |
  | With the load $C_L$ on the output, $\mathrm{GBW} = \frac{g_{m1}}{2 \pi C_L}$, and the DC
  | gain $A_0 \approx \frac{g_{m1}}{g_{ds2} + g_{ds4}}$ is about half the intrinsic gain
  | $g_m/g_{ds}$ of the pair when the mirror is as long as the pair.
var CL 1p
  unit F
var gm_in "gmid.gm(\"nfet_01v8\", gm_id_in, L_in, id_in)"
  unit S
  cached 0.00015000000000000001 6f77c86f9226a930
var GBW gm_in/(2*pi*CL)
  unit Hz
  min 10meg
var Av_in "gmid.gain(\"nfet_01v8\", gm_id_in, L_in)"
  unit V/V
  cached 112.20605997990423 6f77c86f9226a930
var ft_in "gmid.ft(\"nfet_01v8\", gm_id_in, L_in)"
  unit Hz
  cached 2414582200.15373 6f77c86f9226a930
prose d00003
  | ## Mirror load and tail
  |
  | | devices | role | sized by |
  | |---|---|---|
  | | M1, M2 | input pair | `gm_id_in`, `L_in` |
  | | M3, M4 | PMOS mirror load | `gm_id_load`, `L_load` |
  | | M5 | tail current source | `gm_id_tail`, `L_tail` |
  |
  | Low $g_m/I_D$ in the mirror and the tail keeps their mismatch and noise small.
var gm_id_load 10
  unit 1/V
var L_load 1u
  unit m
var W_load "gmid.w(\"pfet_01v8\", gm_id_load, L_load, id_in)"
  unit m
  cached 8.84865072531957e-6 6f77c86f9226a930
var gm_id_tail 8
  unit 1/V
var L_tail 1u
  unit m
var W_tail "gmid.w(\"nfet_01v8\", gm_id_tail, L_tail, Id_tail)"
  unit m
  cached 3.023519651188211e-6 6f77c86f9226a930
prose d00004
  | ## Open-loop response
  |
  | A bench that instantiates this cell fills this graph after a run:
  |
  | ```plot
  | db(v(out))
  | ```
