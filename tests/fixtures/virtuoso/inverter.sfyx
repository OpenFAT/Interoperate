("label" 4 2 "Y" 36 0 "R0" "centerRight" "stick" 6 "normal" "pin" "label")
("label" 5 0 "[@instanceName]" -20 30 "R0" "lowerLeft" "stick" 8 "NLP" "instance" "label")
("label" 6 0 "[@partName]" -20 -30 "R0" "upperLeft" "stick" 8 "NLP" "device" "label")
("shape" 7 "line" "device" "drawing" (-40 0 -20 0) 0)
("shape" 8 "polygon" "device" "drawing" (-20 20 15 0 -20 -20) 0)
("shape" 9 "ellipse" "device" "drawing" (15 -3 21 3) 0)
("shape" 10 "line" "device" "drawing" (21 0 40 0) 0)
("shape" 11 "rect" "instance" "drawing" (-42 -22 42 32) 0)
