("inst" 3 "M1" "analogLib" "nmos4" "symbol" 0 -40 "R0")
("spin" 4 "A" "input" "basic" "ipin" "symbol" -60 0 "R0")
("spin" 5 "Y" "output" "basic" "opin" "symbol" 60 0 "R0")
("wire" 6 (-60 0 -20 0) 0)
("wire" 7 (-20 40 -20 -40) 0)
