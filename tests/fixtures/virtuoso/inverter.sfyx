("cv" "schematic" "schematic" 160)
("inst" 1 "I0" "demo" "inv" "symbol" 0 0 "R0")
("inst" 2 "I3" "analogLib" "gnd" "symbol" -120 -70 "R0")
("inst" 3 "I4" "analogLib" "gnd" "symbol" -80 -70 "R0")
("inst" 4 "V0" "analogLib" "vdc" "symbol" -120 -40 "R0")
("inst" 5 "V1" "analogLib" "vdc" "symbol" -80 -40 "R0")
("wire" 6 (-120 -10 -120 10) 0)
("wire" 7 (-80 -10 -80 0 -40 0) 0)
("wire" 8 (40 0 80 0) 0)
("label" 9 6 "vdd!" -118 10 "R0" "lowerLeft" "stick" 10 "normal" "wire" "label")
("label" 10 7 "in" -60 2 "R0" "lowerLeft" "stick" 10 "normal" "wire" "label")
("label" 11 8 "out" 60 2 "R0" "lowerLeft" "stick" 10 "normal" "wire" "label")
("label" 12 7 "net_in" -60 4 "R0" "lowerLeft" "stick" 8 "normal" "annotate" "drawing3")
("prop" 4 "vdc" "string" "1.8")
("prop" 5 "vdc" "string" "900m")
("end")
