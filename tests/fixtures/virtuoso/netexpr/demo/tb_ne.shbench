schemify 1 shbench

inst 4hmqt8 ./ne
  at 0 0 R0
  name I0
  inherit vdd VDDA
inst 5zz3dj analogLib:vdc
  at -80 40 R0
  name V1
  vdc 1
inst bq7ctq analogLib:vdc
  at -120 40 R0
  name V0
  vdc 3.3

wire 45eq8r -120 -10 -120 10
wire 6vawys -80 0 -40 0
wire nvehcj -80 0 -80 10

label 5yde3w -120 -10 R0 VDDA
label 65rkdg -120 70 R0 GND
  global true
label 6n20v1 -80 70 R0 GND
  global true
label jaq0zs -60 0 R0 a
