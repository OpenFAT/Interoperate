schemify 1 shprim
  provenance "virtuoso analogLib/pmos4"
  vibox -22 -32 25 32
  vsym 42eb1bea59826902

pin D inout 20 30
  vplabel none
pin G in -20 0
  vplabel none
pin S inout 20 -30
  vplabel none
pin B inout 20 0
  vplabel none

param model ""
  kind string
  doc "Model name"
param w 1u
  unit m
  doc Width
param l 180n
  unit m
  doc Length
param m 1
  doc Multiplier

impl spice spice
  format spice "M{name} {D} {G} {S} {B} {model} w={w} l={l} m={m}"
  format spectre "{name} ({D} {G} {S} {B}) pmos4 w={w} l={l} m={m}"

circle -3 0 3

line -20 0 -6 0

poly 5 -15 20 -15 20 -30
poly 5 15 20 15 20 30

stext 25 -8 R0 {name}
  size 0.6
  vlabel annotate drawing7 lowerLeft stick IL cdsName() {name}
