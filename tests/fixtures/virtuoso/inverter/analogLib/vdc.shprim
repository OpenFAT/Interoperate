schemify 1 shprim
  provenance "virtuoso analogLib/vdc"
  vsym 6f0b52b272135bad

pin PLUS inout 0 -30
pin MINUS inout 0 30

param vdc ""
  kind string
  unit V
  doc "DC voltage"
param acm 0
  unit V
  doc "AC magnitude"
param acp 0
  unit deg
  doc "AC phase"
param srcType dc
  kind string
  doc "Source type"

impl spice spice
  format spice "V{name} {PLUS} {MINUS} dc {vdc} ac {acm} {acp}"
  format spectre "{name} ({PLUS} {MINUS}) vsource{vdc != \"\" ? \" dc=\" + vdc : \"\"} mag={acm} phase={acp}{srcType != \"\" ? \" type=\" + srcType : \"\"}"

circle 0 0 15

line 0 -30 0 -15
line 0 15 0 30

stext 18 0 R0 vdc={vdc}
  size 0.6
