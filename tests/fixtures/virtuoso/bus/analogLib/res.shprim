schemify 1 shprim
  provenance "virtuoso analogLib/res"
  vsym f21bf605bff99116

pin PLUS inout 0 -30
pin MINUS inout 0 30

param r 1k
  unit Ohm
  doc Resistance
param m 1
  doc Multiplier

impl spice spice
  format spice "R{name} {PLUS} {MINUS} {r} m={m}"
  format spectre "{name} ({PLUS} {MINUS}) resistor r={r} m={m}"

rect -6 -20 6 20
