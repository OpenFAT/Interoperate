; A symbol with every shape and label kind (spec interop.md §3.5, §6.2).
("sfyx" 1 "SfyExportLib test")
("lib" "demo")
("cell" "shapes" "ref")
("cdf" "w l")
("param" "w" "string" "1u" "Width" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "l" "string" "180n" "Length" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "mode" "cyclic" "fast" "Mode" "" () ("fast" "slow") "")
("param" "flag" "boolean" "nil" "Flag" "" () () "")
("param" "count" "int" "2" "count" "" () () "")
("param" "go" "button" "" "Go" "" () () "")
("siminfo" "spectre" (("componentName" "shapes_dev") ("instParameters" ("w" "l" "count")) ("termOrder" ("A" "B" "C" "VDD"))))
("cv" "symbol" "schematicSymbol" 160)
("term" "A" "input" "")
("term" "B" "output" "")
("term" "C" "inputOutput" "")
("term" "VDD" "inputOutput" "[@vdd:%:vdd!]")
("pinfig" 1 "A" -62 -2 -58 2)
("pinfig" 2 "B" 58 -2 62 2)
("pinfig" 3 "C" -2 38 2 42)
("pinfig" 4 "C" -2 -42 2 -38)
("pinfig" 5 "VDD" 18 38 22 42)
("label" 6 1 "A" -56 0 "R0" "centerLeft" "stick" 6 "normal" "pin" "label")
("label" 7 0 "SHAPES" -20 25 "R0" "centerCenter" "stick" 8 "normal" "annotate" "drawing")
("label" 8 0 "[@instanceName]" -50 30 "R0" "lowerLeft" "stick" 8 "NLP" "instance" "label")
("label" 9 0 "[@partName]" -50 -30 "R0" "upperLeft" "stick" 8 "NLP" "device" "label")
("label" 10 0 "[@w:w=%]" 30 20 "R90" "lowerLeft" "stick" 6 "NLP" "annotate" "drawing")
("label" 11 0 "[@l:l=%:none]" 30 10 "R0" "lowerLeft" "stick" 6 "NLP" "annotate" "drawing")
("label" 12 0 "[@refDes]" 30 0 "R0" "lowerLeft" "stick" 6 "NLP" "device" "annotate")
("label" 13 0 "cdsName()" 30 -10 "R0" "lowerLeft" "stick" 6 "IL" "annotate" "drawing7")
("label" 14 0 "cdsParam(2)" 30 -20 "R0" "lowerLeft" "stick" 6 "IL" "annotate" "drawing")
("label" 15 1 "cdsTerm(\"A\")" -60 4 "R0" "lowerLeft" "stick" 4 "IL" "annotate" "drawing8")
("label" 16 0 "[@userPartName:%:[@phyPartName]]" 30 -30 "R0" "lowerLeft" "stick" 6 "NLP" "annotate" "drawing2")
("shape" 17 "line" "device" "drawing" (-60 0 -40 0) 0)
("shape" 18 "path" "device" "drawing" (40 0 50 0 50 10 60 10) 2)
("shape" 19 "rect" "device" "drawing1" (-40 -20 40 20) 0)
("shape" 20 "polygon" "device" "drawing" (0 20 10 30 -10 30) 0)
("shape" 21 "ellipse" "device" "drawing" (-10 -10 10 10) 0)
("shape" 22 "ellipse" "device" "drawing" (-20 -30 20 -20) 0)
("shape" 23 "arc" "device" "drawing" (-30 -10 -10 10 0 1570796) 0)
("shape" 24 "arc" "device" "drawing" (10 -10 30 10 0 3141593) 0)
("shape" 25 "arc" "device" "drawing" (10 -10 30 10 3141593 4712389) 0)
("shape" 26 "line" "device" "drawing" (0 40 0 20) 0)
("shape" 27 "line" "device" "drawing" (0 -40 0 -20) 0)
("shape" 28 "rect" "instance" "drawing" (-62 -42 62 42) 0)
("end")
