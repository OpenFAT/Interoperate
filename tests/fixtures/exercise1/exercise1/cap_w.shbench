var Lmin 20n
  unit m
  doc "minimum L of the target PDK (server: 20 nm); FreePDK45 dry run: --set Lmin=50n"
var p 2
  doc "length exponent: L = 2^p * Lmin (swept 0..4: Lmin, 2Lmin, 4Lmin, 8Lmin, 16Lmin)"
var L Lmin*2^p
  unit m
var W 1u
  unit m
  doc "channel width (single finger, nf 1)"
var VDD 0.8
  unit V
  doc "supply; the PMOS source and bulk sit at VDD, so every PMOS bias is |VGS|, |VDS| below it"
var VDS 0.35
  unit V
  doc "|VDS| of the measured devices"
var IDW 30u
  unit A/um
  doc "Id/W held constant as W changes (strong-inversion saturation at L = 4 Lmin; re-check gm/Id < 10 on the target PDK)"

corner tt
  lib ${PDK_MODELS} tt

sweep W
  var W
  values 80n 250n 500n 1u 1.5u 2u 3u 4u 5u 6u 7u 8u 9u 10u

output cdb_n abs(im(i(VMDNB)))/(2*pi*x())
  unit F
output cdb_p abs(im(i(VMDPB)))/(2*pi*x())
  unit F
output cgd_n abs(im(i(VMGND)))/(2*pi*x())
  unit F
output cgd_p abs(im(i(VMGPD)))/(2*pi*x())
  unit F
output cgs_n abs(im(i(VMGNS)))/(2*pi*x())
  unit F
output cgs_p abs(im(i(VMGPS)))/(2*pi*x())
  unit F
output csb_n abs(im(i(VMSNB)))/(2*pi*x())
  unit F
output csb_p abs(im(i(VMSPB)))/(2*pi*x())
  unit F

code cap_w spice
  | .op
  | .ac lin 1 1meg 1meg
code oppoint spectre
  | // Spectre only: the intrinsic cgsi/cgdi (and cgsovl, cgdovl, cjd, cjs) of the dc-loop masters
  | save MNM:oppoint MPM:oppoint
