  w W
  l L
inst dm706d core:vsource
  at 310 60 MR180
  name VDPA
  value "dc {-VDS} ac 1"
inst edtxra core:isource
  at 500 330 R0
  name IREFN
  value "dc {IDW*W/1u}"
inst ez7xys core:vsource
  at 890 60 MR180
  name VBPA
