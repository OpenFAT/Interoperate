schemify 1 shbench
  doc "Ex. 1 (b)2: |cgs| |cgd| |cdb| |csb| vs W 80 nm..10 um at L = 4 Lmin, |VDS| = VDS, Id/W held at IDW by a dc loop (F + 1 F); 1 MHz ac on drain / source / bulk copies; cgsi, cgdi from Spectre's oppoint of MNM, MPM"
  corner tt

inst 1wa1mn core:vsource
  at -630 60 R0
  name VDN
  value "dc {VDS}"
inst 3gca3v core:isource
  at 700 255 R0
  name IREFP
  value "dc {IDW*W/1u}"
inst 3vwyq9 core:vsource
  at -750 60 R0
  name VDD
  value {VDD}
inst 46kqme core:ammeter
  at 1020 60 R0
  name VMSPB
  savecurrent false
inst 4wn6js tech:pmos
  at 940 330 R0
  name MPS
  w W
  l L
inst 5w13hn core:vsource
  at 190 60 MR180
  name VDP
  value "dc {-VDS}"
inst 70mjs5 core:vsource
  at -390 60 R0
  name VSNA
  value "dc 0 ac 1"
inst 71abdb tech:nmos
  at 680 465 R0
  name MNS
  w W
  l L
