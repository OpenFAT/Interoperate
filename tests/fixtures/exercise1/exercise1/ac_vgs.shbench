var Lmin 20n
  unit m
  doc "minimum L of the target PDK (server: 20 nm); FreePDK45 dry run: --set Lmin=50n"
var p 0
  doc "length exponent: L = 2^p * Lmin (swept 0..4: Lmin, 2Lmin, 4Lmin, 8Lmin, 16Lmin)"
var L Lmin*2^p
  unit m
var W 1u
  unit m
  doc "channel width (single finger, nf 1)"
var VDD 0.8
  unit V
  doc "supply; the PMOS source and bulk sit at VDD, so every PMOS bias is |VGS|, |VDS| below it"
var VDS 0.35
  unit V
  doc "|VDS| of the measured devices"
var VGS 0.4
  unit V
  doc "|VGS| of every copy (swept)"

corner tt
  lib ${PDK_MODELS} tt

sweep VGS
  var VGS
  lin 0 0.8 81
sweep p
  var p
  values 0 1 2 3 4

output cgd_n abs(im(i(VMGND)))/(2*pi*x())
  unit F
output cgd_p abs(im(i(VMGPD)))/(2*pi*x())
  unit F
output cgg_n abs(im(i(VMGNG)))/(2*pi*x())
  unit F
output cgg_p abs(im(i(VMGPG)))/(2*pi*x())
  unit F
output cgs_n abs(im(i(VMGNS)))/(2*pi*x())
  unit F
output cgs_p abs(im(i(VMGPS)))/(2*pi*x())
  unit F
output fT_n abs(re(i(VMDNG)))*x()/abs(im(i(VMGNG)))
  unit Hz
output fT_p abs(re(i(VMDPG)))*x()/abs(im(i(VMGPG)))
  unit Hz
output gds_n abs(re(i(VMDND)))
  unit S
output gds_p abs(re(i(VMDPD)))
  unit S
output gm_n abs(re(i(VMDNG)))
  unit S
output gm_p abs(re(i(VMDPG)))
  unit S
output gmro_n abs(re(i(VMDNG)))/abs(re(i(VMDND)))
  unit V/V
output gmro_p abs(re(i(VMDPG)))/abs(re(i(VMDPD)))
  unit V/V

code ac_vgs spice
  | .op
  | .ac lin 1 1meg 1meg
