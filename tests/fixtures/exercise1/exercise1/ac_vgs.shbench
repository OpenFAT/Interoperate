schemify 1 shbench
  doc "Ex. 1 (a)1,2,4 and (b)3: gm, gds, cgg, cgs, cgd per bias point from a 1 MHz ac (AC 1 on gate / drain / source copies), |VGS| swept 0..VDD, |VDS| = VDS, W = 1 um, L = 2^p Lmin; Id from the .op"
  corner tt

inst 29cbrf core:vsource
  at -580 60 R0
  name VGNA
  value "dc {VGS} ac 1"
inst 5m5c4t core:ammeter
  at 1050 135 R0
  name VMGPS
  savecurrent false
inst 66vk8q core:vsource
  at 990 60 MR180
  name VGP
  value "dc {-VGS}"
inst 6depmn core:vsource
  at -460 60 R0
  name VGN
  value "dc {VGS}"
inst 6wcvb2 core:vsource
  at -100 60 R0
  name VSNA
  value "dc 0 ac 1"
inst 9ahrem core:ammeter
  at 560 60 R0
  name VMDNG
  savecurrent false
inst a98rsy tech:pmos
  at 1720 60 R0
  name MPD
  w W
  l L
inst bn2xe5 core:ammeter
  at 60 60 R0
  name VMGNG
  savecurrent false
inst dc6gm7 tech:nmos
  at 790 135 R0
  name MND
  w W
  l L
inst dj05yx tech:pmos
  at 1530 60 R0
  name MPG
  w W
  l L
inst gtbf4t core:vsource
  at -220 60 R0
