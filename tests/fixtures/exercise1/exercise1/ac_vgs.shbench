  w W
  l L
inst msm7hr core:ammeter
  at 1740 135 R0
  name VMDPD
  savecurrent false
inst p7fxf3 core:vsource
  at -700 60 R0
  name VDD
  value {VDD}
inst p9dj5p tech:pmos
  at 1340 135 R0
  name MPS
  w W
  l L
inst pp4tv3 core:ammeter
  at 620 60 R0
  name VMGND
  savecurrent false
inst q5fhxe tech:nmos
  at 290 60 MR180
  name MNS
  w W
  l L
inst s4vzpb core:vsource
  at 1170 60 MR180
  name VDP
  value "dc {-VDS}"
inst sd7110 core:vsource
  at 1110 60 MR180
  name VDPA
  value "dc {-VDS} ac 1"
inst tyxmr1 core:ammeter
  at 930 135 R0
  name VMGPD
  savecurrent false
inst v5e4hv core:ammeter
  at 870 135 R0
  name VMGPG
  savecurrent false
inst xej2fm core:vsource
  at -340 60 R0
  name VDNA
  value "dc {VDS} ac 1"
inst ymqctc core:ammeter
  at 810 60 R0
  name VMDND
  savecurrent false

