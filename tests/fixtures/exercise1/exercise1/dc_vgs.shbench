schemify 1 shbench
  doc "Ex. 1 (a)3 and (b)4: Id and Ig vs |VGS| 0..VDD in 1 mV (dc sweep of VG), |VDS| = VDS, W = 1 um, L = 2^p Lmin; SSW, IOFF, gate current"
  corner tt

inst 23yfkm core:ammeter
  at 570 135 R0
  name VMGP
  savecurrent false
inst 312nym core:vsource
  at -150 60 R0
  name VD
  value "dc {VDS}"
inst 3df22r core:ammeter
  at 320 135 R0
  name VMDN
  savecurrent false
inst 4rqg66 core:ammeter
  at 260 135 R0
  name VMGN
  savecurrent false
inst br7ewh tech:pmos
  at 620 60 R0
  name MP
  w W
  l L
inst eqz4hy core:vcvs
  at 200 135 MR180
  name EDP
  value -1
inst h1p2ny core:ammeter
  at 640 135 R0
  name VMDP
  savecurrent false
inst nhbkmw tech:nmos
  at 490 135 MR180
  name MN
  w W
  l L
inst qym9a0 core:vsource
  at -390 60 R0
  name VDD
  value {VDD}
inst s93wj2 core:vsource
  at -270 60 R0
  name VG
  value "dc {VGS}"
inst s9rg03 core:vcvs
  at 70 135 MR180
  name EGP
  value -1

wire 18jds4 640 90 640 105
wire 2pfamv 570 60 600 60
wire 3hgf8b -150 90 -150 120
wire 6mm6y8 -270 0 -270 30
wire 8t6z0p 0 60 30 60
wire agr429 70 165 70 255
wire am9743 260 165 260 195
wire b3wvgf 160 60 160 115
wire b49b6k 260 60 260 105
wire bcdz9p 130 60 160 60
wire c40gz9 -270 90 -270 120
wire d6h0ck 510 60 510 105
wire dyahp2 -150 0 -150 30
wire fzk9wb 200 0 200 105
wire gs80ky 200 0 640 0
wire gys17p 510 165 510 195
wire j0pm82 30 155 30 195
wire k2f166 200 165 200 255
wire kw9gw1 440 135 470 135
wire p5d509 30 60 30 115
wire qnhgrt 640 0 640 30
wire qr2tza 570 60 570 105
wire rr4hkh 130 195 160 195
wire t4my9j 320 60 320 105
wire t9mm3m -390 0 -390 30
wire tgm11s 320 165 320 195
wire tkdw7j 160 155 160 195
wire v8v3nh -390 90 -390 120
wire wydz3p 640 165 640 195
wire y63kda 570 165 570 195
wire yab5qw 70 0 70 105
wire z4ax6g 0 195 30 195
wire z5ys1c 70 0 200 0

label 05j7cw 130 195 R180 dn
label 0xwxb5 570 195 R90 gp
label 2kxyaw -150 120 R90 0
label 3h0zy2 200 255 R90 dp
label 3nn2ek -270 0 R270 gn
label 4vsq0y -270 120 R90 0
label 58n9be 320 195 R90 dn1
label 7r0e4v 70 255 R90 gp
label 8j15sv 640 97 R0 dp1
label ax753t 260 60 R270 gn
label axcevs 510 195 R90 dn1
label bdskjs -390 120 R90 0
label bh0h1r -150 0 R270 dn
label dd8zrh 320 60 R270 dn
label e5zfx3 570 82 R0 gp1
label jzb9fk 510 135 R0 0
label nyw5mj 640 195 R90 dp
label pyr5m3 0 0 R90 0
label r5ngyf 200 0 R270 vdd
label rd7ac5 510 60 R270 0
label tne8x0 640 60 R0 vdd
label vegjph -390 0 R270 vdd
label xdpj6h 440 135 R180 gn1
label y4jzt9 260 195 R90 gn1
label yegx9r 130 60 R180 0
label yg1np1 0 60 R180 0
label yp1nf6 0 195 R180 gn

var Lmin 20n
  unit m
  doc "minimum L of the target PDK (server: 20 nm); FreePDK45 dry run: --set Lmin=50n"
var p 0
  doc "length exponent: L = 2^p * Lmin (swept 0..4: Lmin, 2Lmin, 4Lmin, 8Lmin, 16Lmin)"
var L Lmin*2^p
  unit m
var W 1u
  unit m
  doc "channel width (single finger, nf 1)"
var VDD 0.8
  unit V
  doc "supply; the PMOS source and bulk sit at VDD, so every PMOS bias is |VGS|, |VDS| below it"
var VDS 0.35
  unit V
  doc "|VDS| of the measured devices"
var VGS 0
  unit V
  doc "|VGS|: the dc analysis sweeps source VG over 0..VDD; this is only its idle value"

corner tt
  lib ${PDK_MODELS} tt

sweep p
  var p
  values 0 1 2 3 4

output IG_n abs(at(i(VMGN),VDD))
  unit A
output IG_p abs(at(i(VMGP),VDD))
  unit A
output IOFF_n abs(at(i(VMDN),0))/W*1u
  unit A/um
output IOFF_p abs(at(i(VMDP),0))/W*1u
  unit A/um
output ION_n abs(at(i(VMDN),VDD))/W*1u
  unit A/um
output ION_p abs(at(i(VMDP),VDD))/W*1u
  unit A/um
output SSW_n 1000*ymin(1/max(deriv(log10(abs(i(VMDN)))),1m))
  unit mV/dec
output SSW_p 1000*ymin(1/max(deriv(log10(abs(i(VMDP)))),1m))
  unit mV/dec
output rg_n 1/abs(at(deriv(i(VMGN)),VDD))
  unit Ohm
output rg_p 1/abs(at(deriv(i(VMGP)),VDD))
  unit Ohm

spec SSW_n
  min 59.5
spec SSW_p
  min 59.5

code dc_vgs spice
  | .dc VG 0 0.8 1m
