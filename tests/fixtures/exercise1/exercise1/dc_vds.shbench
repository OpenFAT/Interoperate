schemify 1 shbench
  doc "Ex. 1 (b)1: ro = 1/(dId/dVDS) vs |VDS| 0..VDD in 1 mV (dc sweep of VD), |VGS| = VGS = 0.4 V, W = 1 um, L = 2^p Lmin"
  corner tt

inst 1p6y31 core:vsource
  at -150 60 R0
  name VD
  value "dc {VDS}"
inst 58n3mw core:vcvs
  at 200 135 MR180
  name EDP
  value -1
inst 67hrtv core:ammeter
  at 570 135 R0
  name VMGP
  savecurrent false
inst a0y5b4 core:ammeter
  at 320 135 R0
  name VMDN
  savecurrent false
inst d85rc2 core:vcvs
  at 70 135 MR180
  name EGP
  value -1
inst dhnqzb core:vsource
  at -390 60 R0
  name VDD
  value {VDD}
inst kdvm43 core:ammeter
  at 260 135 R0
  name VMGN
  savecurrent false
inst nd9jww core:vsource
  at -270 60 R0
  name VG
  value "dc {VGS}"
inst q83q59 tech:nmos
  at 490 135 MR180
  name MN
  w W
  l L
inst syf3y9 tech:pmos
  at 620 60 R0
  name MP
  w W
  l L
inst v7pa3x core:ammeter
  at 640 135 R0
  name VMDP
  savecurrent false

wire 08ydqa 30 155 30 195
wire 0gr5zs 570 60 600 60
wire 1nt8j1 510 165 510 195
wire 4hj1h6 570 165 570 195
wire 6ass4z 130 60 160 60
wire 8sn8qp -390 0 -390 30
wire abw2vd -270 0 -270 30
wire ahy2jm 640 165 640 195
wire ajmadn 0 60 30 60
wire b5ppf4 -270 90 -270 120
wire b5s3ce -390 90 -390 120
wire ds3efd 130 195 160 195
wire eekbp1 200 165 200 255
wire eqjst4 510 60 510 105
wire f1cdak 200 0 640 0
wire f8wn6d 640 90 640 105
wire fx9gtd 200 0 200 105
wire g0k4jg 160 60 160 115
wire g7m31q 320 165 320 195
wire j8gg0p 70 0 70 105
wire jvjtge 160 155 160 195
wire kandre 0 195 30 195
wire p8qc22 -150 90 -150 120
wire r317d5 440 135 470 135
wire r3c6fj 70 0 200 0
wire s5rx27 260 60 260 105
wire sjc58k 260 165 260 195
wire sts137 320 60 320 105
wire v7j0a5 -150 0 -150 30
wire weterh 70 165 70 255
wire wp6nnk 30 60 30 115
wire ww1753 640 0 640 30
wire zyw6ck 570 60 570 105

label 127v9f -270 120 R90 0
label 14sbc8 320 60 R270 dn
label 2bwr5a 570 82 R0 gp1
label 3a7jw7 -270 0 R270 gn
label 4cw5nh 260 195 R90 gn1
label 5d3jh7 640 60 R0 vdd
label 5htcgj 200 0 R270 vdd
label 6gvk0d 320 195 R90 dn1
label b5h3tf 0 60 R180 0
label d2w6yy 260 60 R270 gn
label d5y1ks 510 135 R0 0
label da4qmg 130 60 R180 0
label dd1q0g 0 195 R180 gn
label eztwdp 570 195 R90 gp
label jn7543 70 255 R90 gp
label p7gkad -150 0 R270 dn
label pstf3s 200 255 R90 dp
label pwsbfy 440 135 R180 gn1
label qqd4gs 510 60 R270 0
label qxt0qk -150 120 R90 0
label rcwx8t 640 195 R90 dp
label rmps3k -390 120 R90 0
label xycvdp -390 0 R270 vdd
label xzc2wd 130 195 R180 dn
label y11qjw 510 195 R90 dn1
label yf6982 0 0 R90 0
label zd5hn7 640 97 R0 dp1

var Lmin 20n
  unit m
  doc "minimum L of the target PDK (server: 20 nm); FreePDK45 dry run: --set Lmin=50n"
var p 0
  doc "length exponent: L = 2^p * Lmin (swept 0..4: Lmin, 2Lmin, 4Lmin, 8Lmin, 16Lmin)"
var L Lmin*2^p
  unit m
var W 1u
  unit m
  doc "channel width (single finger, nf 1)"
var VDD 0.8
  unit V
  doc "supply; the PMOS source and bulk sit at VDD, so every PMOS bias is |VGS|, |VDS| below it"
var VDS 0.35
  unit V
  doc "|VDS| of the measured devices"
var VGS 0.4
  unit V
  doc "|VGS| held during the |VDS| sweep"

corner tt
  lib ${PDK_MODELS} tt

sweep p
  var p
  values 0 1 2 3 4

output ro_n 1/at(deriv(i(VMDN)),VDS)
  unit Ohm
output ro_p 1/at(deriv(i(VMDP)),VDS)
  unit Ohm

code dc_vds spice
  | .dc VD 0 0.8 1m
